b176c0224f4321e9aa5cc6ce4c9d86d14ffe887f0487dc872","url":"https://www.wafabourse.com/fr/market-tracking/instruments-financiers"}]}}},"lessons":{"volume_conflicts_need_corroboration":{"id":"volume_conflicts_need_corroboration","first_seen":"2026-10-18T22:02:40.471799+01:00","last_seen":"2026-10-18T22:02:40.471799+01:00","occurrences":1,"title":"Volumes de clôture corrigés tardivement","rule":"Conserver avant/après et corriger uniquement les volumes confirmés ligne par ligne sur la même séance par deux fournisseurs. Ne pas effacer un conflit sans preuve.","evidence":[]},"money_is_not_share_quantity":{"id":"money_is_not_share_quantity","first_seen":"2026-10-18T22:02:40.471799+01:00","last_seen":"2026-10-18T22:02:40.471799+01:00","occurrences":1,"title":"Colonne Qté monétaire dans un export PDF","rule":"Lire les unités et le contrat de chaque champ. Le PDF Wafabourse du 18/10/2026 duplique les DH dans Qté ; utiliser QteEchangee de son API pour les titres.","evidence":[]},"totals_can_hide_offsetting_errors":{"id":"totals_can_hide_offsetting_errors","first_seen":"2026-10-18T22:02:40.471799+01:00","last_seen":"2026-10-18T22:02:40.471799+01:00","occurrences":1,"title":"Un total égal peut masquer des erreurs opposées","rule":"Contrôler aussi chaque ligne, les identités, les quantités, la séance et le périmètre ; une somme égale ne valide pas les composants.","evidence":[]},"opening_optional_market_fields":{"id":"opening_optional_market_fields","first_seen":"2026-10-19T09:52:53.758018+00:00","last_seen":"2026-10-19T09:52:53.758018+00:00","occurrences":1,"title":"Quantité absente à l’ouverture de séance","rule":"Une quantité absente reste indisponible avec son unité explicite. Zéro et absence sont distincts. Tester une séance intrajournalière à montant nul avec quantité absente et compteur de transactions présent ; aucun recoupement définitif ne doit être inventé.","evidence":[{"url":"https://github.com/abdmoutalib207-lang/bvc-analyzer-nour/actions/runs/39232644530"}]},"intraday_context_scope":{"id":"intraday_context_scope","first_seen":"2026-10-19T14:53:08.506Z","last_seen":"2026-10-19T14:53:08.506Z","occurrences":1,"title":"Contexte IA limité aux titres demandés","rule":"Une synthèse de titre ne reçoit que ses cotations provisoires, avec le nombre global et les réserves conservés. Garder le catalogue des leçons pour les questions sur le journal. Tester 80 cotations sans retirer les preuves financières ni augmenter le budget.","evidence":[{"url":"https://github.com/abdmoutalib207-lang/bvc-analyzer-nour/actions/runs/39233516544"}]},"closed_session_reference":{"id":"closed_session_reference","first_seen":"2026-10-19T14:59:24.887Z","last_seen":"2026-10-19T14:59:24.887Z","occurrences":1,"title":"Comparer les dates à la dernière clôture validée","rule":"Pendant la séance, la date de l’indice provisoire n’est pas celle de la dernière clôture. Évaluer l’âge des fiches contre une clôture validée, conserver les alertes réellement anciennes et tester séparément séance ouverte et clôturée. Les tests de conversation ne doivent pas supposer ADI toujours à jour.","evidence":[{"url":"https://github.com/abdmoutalib207-lang/bvc-analyzer-nour/actions/runs/39273096120"}]},"fixture_relative_test_clock":{"id":"fixture_relative_test_clock","first_seen":"2026-10-19T17:45:07.889Z","last_seen":"2026-10-19T17:45:07.889Z","occurrences":1,"title":"Horloge des tests compatible avec la séance contrôlée","rule":"Les tests utilisant le snapshot mobile datent leur horloge après la séance réellement testée. Une date figée dans le passé ne doit pas bloquer la publication de nouvelles séances. Garder le refus des cotations futures, les preuves de conflit et l’immutabilité des entrées.","evidence":[{"url":"https://github.com/abdmoutalib207-lang/bvc-analyzer-nour/actions/runs/39281298253"}]},"partial_detail_never_certifies_aggregate":{"id":"partial_detail_never_certifies_aggregate","first_seen":"2026-10-19T17:57:33.513Z","last_seen":"2026-10-19T17:57:33.513Z","occurrences":1,"title":"Publier les titres recoupés sans certifier un agrégat divergent","rule":"Une publication limitée aux lignes détaillées exige deux fournisseurs datés, des empreintes et une correspondance exacte par titre avec le rapport final. Le total annoncé divergent reste non confirmé et son incident ouvert. Aucune ligne manquante ni correction automatique n'est inventée.","evidence":[{"url":"https://github.com/abdmoutalib207-lang/bvc-analyzer-nour/blob/main/tests/test_detail_scope.py"}]},"field_dates_not_index_clock":{"id":"field_dates_not_index_clock","first_seen":"2026-10-19T18:43:32.576Z","last_seen":"2026-10-19T18:43:32.576Z","occurrences":1,"title":"La date d’un indice ne certifie pas ses compteurs associés","rule":"Conserver le compteur source brut et signaler sa date propre non attestée. Une référence officielle revue reste datée, avec son libellé contrats distinct de transactions ; elle ne s’applique qu’à la même séance et aux mêmes agrégats. Ne pas rattacher un compteur à une autre séance par déduction ni présenter une capture humaine comme collecte automatique.","evidence":[{"url":"https://www.casablanca-bourse.com/market-data/volume"},{"sha256":"50a117bea73088602a4b873c60f45669b517a1c85476fcc51cc88f46af546149"}]},"dated_market_exports_keep_segments":{"id":"dated_market_exports_keep_segments","first_seen":"2026-10-19T20:49:00+00:00","last_seen":"2026-10-19T20:49:00+00:00","occurrences":1,"title":"Historique daté : distinguer marchés et compteurs","rule":"Rapprocher la date de la ligne, le marché et les unités. L’export fourni donne 3 671 transactions le 19/10, 3 114 le 16/10 ; 52 945 136,05 MAD et 199 770 unités appartiennent au 12/10. Ne pas additionner les transferts ou opérations sur capital au marché central, ne pas dater un compteur brut par déduction, ne pas résoudre un écart par titre avec un total seul.","evidence":[{"document":"historique_volume.xlsx","sheet":"in","rows":[2,3,11],"raw_sha256":"a8e93cc8455683d2beb774bfede0915902fba6a8cb13bc9924079ee9a3c10785"}]},"volume_fixture_isolation":{"id":"volume_fixture_isolation","first_seen":"2026-10-21T22:45:15.540Z","last_seen":"2026-10-21T22:45:15.540Z","occurrences":1,"title":"Un scénario de test doit définir tous ses audits","rule":"Quand un scénario remplace le marché ou le rapprochement externe, fixer aussi son audit interne au lieu d’hériter du relevé courant. Exécuter les tests de volumes sous les états matched, discrepancy, incomplete et unavailable. Ne jamais retirer une assertion financière pour faire passer une publication.","evidence":[{"url":"https://github.com/abdmoutalib207-lang/bvc-analyzer-nour/actions/runs/39669754678"}]},"issuer_quote_clock_is_not_run_clock":{"id":"issuer_quote_clock_is_not_run_clock","title":"Le prix principal et ses deux horloges","rule":"Afficher le dernier point provisoire admissible en premier sans changer la clôture canonique. Conserver séparément l’heure source de cotation et l’heure de collecte propre au titre. Un passage global, une construction de page ou une observation en conflit ne redatent jamais un cours ancien.","first_seen":"2026-10-22T17:05:40.138Z","last_seen":"2026-10-22T17:05:40.138Z","occurrences":1,"evidence":[{"url":"https://www.wafabourse.com/fr/market-tracking/instruments-financiers"}]},"secondary_quote_placeholder_date":{"id":"secondary_quote_placeholder_date","title":"Date de transaction 1900 sur ALM","rule":"Une ligne de marché datée 01/01/1900 ne peut pas être affectée à la séance courante par l’heure du téléchargement ou du MASI, même si ses montants semblent cohérents. Conserver le blocage et rechercher une preuve indépendante datée. Observation du 22/10/2026 : Wafabourse ALM, 2 titres, 3 720 MAD, 1 860 MAD par titre.","first_seen":"2026-10-22T17:05:40.138Z","last_seen":"2026-10-22T17:05:40.138Z","occurrences":1,"evidence":[{"url":"https://www.wafabourse.com/fr/market-tracking/instruments-financiers"}]},"primary_publication_is_not_multisource":{"id":"primary_publication_is_not_multisource","title":"Fraîcheur et niveau de preuve distincts","rule":"Une source secondaire invalide ne valide ni ne corrige rien. Publier avec réserves seulement le snapshot inchangé conforme à chaque ligne principale et à ses agrégats, avec preuve liée au SHA-256. Un conflit secondaire valide reste bloquant ; aucun incident résolu par ce mode.","first_seen":"2026-10-22T20:30:09.108Z","last_seen":"2026-10-22T20:30:09.108Z","occurrences":1,"evidence":[]},"statistical_windows_require_trades_and_calendar":{"id":"statistical_windows_require_trades_and_calendar","first_seen":"2026-10-22T22:53:37.200888+00:00","last_seen":"2026-10-22T22:53:37.200888+00:00","occurrences":1,"title":"Séances sans échange et trous de calendrier","rule":"Les fenêtres de rendement utilisent le calendrier MASI et rejettent toute séance sans échange, absente, invalide ou dupliquée ; elles ne rapprochent jamais deux cours séparés par un trou en une séance quotidienne. Les frontières de capital/reprise documentées excluent les fenêtres concernées. Contrôle Decimal indépendant des indicateurs, liquidité et fréquences avant publication ; aucune source ni dette contestée déclarée certifiée.","evidence":[{"url":"https://github.com/abdmoutalib207-lang/bvc-analyzer-nour/blob/nour-calculation-audit-oct22/docs/calculation-audit-2026-10-22.md"}]},"annual_profit_scope_and_exact_capital":{"id":"annual_profit_scope_and_exact_capital","first_seen":"2026-10-22T23:35:00+00:00","last_seen":"2026-10-22T23:35:00+00:00","occurrences":1,"title":"Résultat attribuable, social et capital exact","rule":"Ne jamais remplacer le RNPG par le total consolidé. Reclasser un résultat social sous sa clé explicite après lecture primaire, en conservant l’ancien fait. Déduire les titres du capital annuel exact et du nominal officiel, jamais d’un capital arrondi ou d’une capitalisation. Conserver pertes, fonds propres négatifs, réserves CAC et conflits documentaires. Une page contrôlée ne certifie pas les autres faits du dossier.","evidence":[{"url":"https://www.ammc.ma/sites/default/files/CTM_RFA_2025.pdf"},{"url":"https://www.ammc.ma/sites/default/files/Lesieur_Cristal_RFA_2025.pdf"}]},"issuer_fault_isolation_requires_absent_unsafe_outputs":{"id":"issuer_fault_isolation_requires_absent_unsafe_outputs","first_seen":"2026-10-23T03:27:19.308130+01:00","last_seen":"2026-10-23T03:27:19.308130+01:00","occurrences":1,"title":"Une divergence locale ne doit pas interrompre les autres sociétés","rule":"Conserver les oracles indépendants ; suspendre seulement les sorties locales concernées, conserver la preuve et le dernier état sain daté. Une mise en quarantaine n’accepte jamais une valeur numérique erronée. Les défauts d’identité, schéma, sécurité ou intégrité globale refusent le nouvel artefact complet.","evidence":[]},"issuer_standard_never_sector_default":{"id":"issuer_standard_never_sector_default","first_seen":"2026-10-26T22:49:22.922127+00:00","last_seen":"2026-10-26T22:49:22.922127+00:00","occurrences":1,"title":"Référentiel comptable par publication, jamais par secteur","rule":"Lire le référentiel de la société, de la période et du périmètre. La cotation ne rend pas tous les consolidés IFRS. Une règle sectorielle générale ne convertit aucun compte ; une nouvelle période ou empreinte exige une nouvelle revue.","evidence":[{"sha256":"88448b1e781657ec25a793f1ff3e41ad425b7b13b04fe529bc5485b1bbac7303","url":"https://www.ammc.ma/sites/default/files/pieces-jointes/Recueil_AMMC_VF_%20Mars%202026.pdf"},{"sha256":"68186ab90906052a10d96579b10446c9e3b889e8017c5e53edeab291df5efaa1","url":"https://www.ammc.ma/sites/default/files/TGCC_RFA_2025.pdf"}]},"research_expense_not_auto_capitalization":{"id":"research_expense_not_auto_capitalization","first_seen":"2026-10-26T22:49:22.922127+00:00","last_seen":"2026-10-26T22:49:22.922127+00:00","occurrences":1,"title":"HPS : vérifier les charges de développement avant interprétation","rule":"IAS 38 ne signifie pas activation automatique. HPS 2025 déclare ses frais de recherche et développement en charges dans ses comptes en normes marocaines. Lire les méthodes avant d’attribuer une hausse du bénéfice à une capitalisation.","evidence":[{"sha256":"d50b7fda92170c16ace9e1f649286333a0175f74c2051fc7856b179351b88ee2","url":"https://www.ammc.ma/sites/default/files/HPS_RFA_2025.pdf"}]},"accounting_changes_keep_published_and_restated":{"id":"accounting_changes_keep_published_and_restated","first_seen":"2026-10-26T22:49:22.922127+00:00","last_seen":"2026-10-26T22:49:22.922127+00:00","occurrences":1,"title":"Changement de méthode : conserver publié, retraité et simulation","rule":"ADI, RDS et Wafa Assurance 2025 publient des indications de changement de méthode. Séparer les périmètres et les comparatifs retraités. Une simulation à règles constantes ne remplace jamais le chiffre publié, ni ne résout un écart de dette sans pont chiffré.","evidence":[{"sha256":"0d076ef448b6228ec8ff2ad60c2368044382d545ef84f51afb133636e4c538bc","url":"https://www.ammc.ma/sites/default/files/ADI_RFA_2025.pdf"},{"sha256":"af0e17be057fcc51f43834745462b8ca07dc9c9de506cf3340ca0330ca8576fd","url":"https://www.ammc.ma/sites/default/files/RDS_RFA_2025.pdf"},{"sha256":"162f0a480d639cd9e19b6e44304d6170bd47f5c5ab899dc3260d7db0fc3b8ec6","url":"https://www.ammc.ma/sites/default/files/Wafa_Assurance_RFA_2025.pdf"}]},"accounting_candidate_title_is_not_method_evidence":{"id":"accounting_candidate_title_is_not_method_evidence","first_seen":"2026-10-27T02:34:56.182217+00:00","last_seen":"2026-10-27T02:34:56.182217+00:00","occurrences":1,"title":"Une page candidate ne prouve pas une méthode comptable","rule":"Un PDF officiel ou une occurrence de référentiel ne prouve pas le choix comptable de l’émetteur. Les références RNVA du rapport AGMA sont des sujets métier, pas une note CGNC. Conserver la déclaration et les chiffres disponibles sans promouvoir la revue de méthodes tant que la page explicite manque.","evidence":[{"sha256":"7558ce34b46cbe9bf95d2c73a26cbe5cf2bd7aed678be5cde140ae65ac427f5c","url":"https://www.ammc.ma/sites/default/files/Agma_RFA_2025.pdf"}]},"property_accounting_basis_is_issuer_specific":{"id":"property_accounting_basis_is_issuer_specific","first_seen":"2026-10-27T02:34:56.183092+00:00","last_seen":"2026-10-27T02:34:56.183092+00:00","occurrences":1,"title":"Foncières : distinguer juste valeur et coût historique","rule":"Immorente 2025 décrit une juste valeur réévaluée annuellement ; Balima 2025 conserve son patrimoine au coût historique en normes marocaines. Comparer les résultats et actifs avec leur méthode publiée. Ne jamais inventer de retraitement IFRS, de FFO ou d’ANR pour rendre les bases comparables.","evidence":[{"sha256":"a17430459e934288da9b28fe7c7a59f550bd4ecc28b74cb6af80515f0714b2b4","url":"https://www.ammc.ma/sites/default/files/Immorente_Invest_RFA_2025.pdf"},{"sha256":"b81d7f5f74da6f29c27e25f04b696c3cc7c7b52a9dae7f66a93291cfcdd7c8e6","url":"https://www.ammc.ma/sites/default/files/Balima_RFA_2025_0.pdf"}]},"browser_fixture_includes_review_clock":{"id":"browser_fixture_includes_review_clock","first_seen":"2026-10-27T02:41:43.864789+00:00","last_seen":"2026-10-27T02:41:43.864789+00:00","occurrences":1,"title":"Scénario navigateur : dater aussi la connaissance comptable","rule":"Le scénario de quarantaine doit prendre une date d’analyse incluant la dernière revue comptable qu’il teste. Conserver les dates de collecte et de séance inchangées. Une analyse réellement antérieure doit continuer à exclure ces méthodes : ne jamais retirer le garde-fou temporel pour satisfaire le scénario.","evidence":[{"url":"https://github.com/abdmoutalib207-lang/bvc-analyzer-nour/blob/main/tools/test_quarantined_browser.py"}]}},"updated_at":"2026-10-27T14:56:54.096975+00:00","last_audit":{"session":"2026-10-27","status":"intraday","checked_at":"2026-10-27T14:56:54.096975+00:00"}}
